# Copy this file to infra/deploy.env and fill in your values.
# deploy.env is gitignored — never commit it.

AWS_PROFILE=your-aws-sso-profile
DOMAIN=lore.malha.land
DIST_ID=YOUR_CLOUDFRONT_DISTRIBUTION_ID   # from stack output after first deploy
NOVA_ACT_API_KEY=your-nova-act-api-key    # optional: enables smoke tests after deploy (pip install nova-act)
