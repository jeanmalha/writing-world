# Copy to infra/backend.env and fill in your values.
# backend.env is gitignored — never commit it.

AWS_PROFILE=perso

# Must be globally unique across all AWS accounts.
# e.g. writingworld-jm42  (use a short unique suffix)
COGNITO_DOMAIN_PREFIX=writingworld-yourname

# Models — Simple (fast/cheap) and Complex (thorough)
# SIMPLE_MODEL=openai.gpt-oss-20b-1:0
# COMPLEX_MODEL=global.anthropic.claude-sonnet-4-6

# IMPORTANT: Enable both models in the AWS Console before deploying:
# Amazon Bedrock → Model access → enable GPT OSS 20B and Claude Sonnet
# (in the same region as this stack, us-east-1)
